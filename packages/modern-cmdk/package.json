{
  "name": "modern-cmdk",
  "version": "1.4.0",
  "type": "module",
  "description": "The definitive command palette engine for the modern web",
  "license": "MIT",
  "homepage": "https://github.com/ABCrimson/modern-cmdk#readme",
  "bugs": {
    "url": "https://github.com/ABCrimson/modern-cmdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "default": "./dist/core/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "default": "./dist/react/index.mjs"
    },
    "./react/dialog": {
      "types": "./dist/react/dialog.d.mts",
      "default": "./dist/react/dialog.mjs"
    },
    "./styles.css": "./dist/react/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.mjs",
  "types": "./dist/core/index.d.mts",
  "bin": {
    "modern-cmdk": "./dist/codemod/bin.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-styles.ts",
    "dev": "tsdown --watch src/react/styles.css --on-success \"node scripts/build-styles.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0 <21.0.0",
    "react-dom": ">=19.0.0 <21.0.0",
    "radix-ui": ">=1.4.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "lightningcss": "1.33.0",
    "radix-ui": "catalog:"
  },
  "keywords": [
    "command-palette",
    "command-menu",
    "cmdk",
    "headless",
    "state-machine",
    "react",
    "react-19"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/modern-cmdk.git",
    "directory": "packages/modern-cmdk"
  }
}
