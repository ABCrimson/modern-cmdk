{
  // Type-checks the vitest benches and the standalone harness. Run after `pnpm build`: the `modern-cmdk`
  // path below resolves to the built dist declarations, the same files the standalone harness imports.
  // The wasm package resolves to its source instead: its dist exists only after the Rust build, and
  // src/pkg.d.ts (included below) stands in for the wasm-pack output, so this check needs no pkg/.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "modern-cmdk": ["../packages/modern-cmdk/dist/core/index.d.mts"],
      "modern-cmdk-search-wasm": ["../packages/command-search-wasm/src/index.ts"]
    }
  },
  "include": ["*.bench.ts", "standalone/**/*.ts", "../packages/command-search-wasm/src/pkg.d.ts"]
}
