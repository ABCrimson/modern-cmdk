{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": {
      "modern-cmdk": ["../packages/modern-cmdk/src/core/index.ts"],
      "modern-cmdk/react": ["../packages/modern-cmdk/src/react/index.ts"],
      "modern-cmdk/react/dialog": ["../packages/modern-cmdk/src/react/dialog.tsx"]
    }
  },
  "include": [
    "unit/**/*",
    "setup.ts",
    "../benchmarks/standalone/compare-rules.ts",
    "../vitest.config.ts",
    "../playwright.config.ts",
    "../packages/create-modern-cmdk/templates/*/src/App.tsx",
    "../packages/create-modern-cmdk/src/raw.d.ts",
    "../packages/create-modern-cmdk/src/env.d.ts"
  ],
  "exclude": ["dist/**", "e2e/**"]
}
