{
  "name": "modern-cmdk-codemod",
  "version": "1.0.2",
  "type": "module",
  "description": "Codemods that migrate cmdk code to modern-cmdk: four jscodeshift transforms that report every site they cannot migrate instead of guessing.",
  "license": "MIT",
  "homepage": "https://abcrimson.github.io/modern-cmdk/guide/migration-from-cmdk.html",
  "bugs": {
    "url": "https://github.com/ABCrimson/modern-cmdk/issues"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "modern-cmdk-codemod": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jscodeshift": "catalog:"
  },
  "devDependencies": {
    "@types/jscodeshift": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "codemod",
    "jscodeshift",
    "cmdk",
    "modern-cmdk",
    "migration",
    "command-palette",
    "react",
    "react-19"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/modern-cmdk.git",
    "directory": "packages/modern-cmdk-codemod"
  }
}
