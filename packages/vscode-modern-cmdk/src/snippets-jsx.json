{
  "Command Component with ref (React 19)": {
    "prefix": "cmd-component-ref",
    "body": [
      "import { Command } from 'modern-cmdk/react';",
      "",
      "// React 19: ref is a regular prop, no forwardRef needed.",
      "// Command renders no ref target of its own, so the ref goes on a wrapping div.",
      "/** @param {{ ref?: import('react').Ref<HTMLDivElement> } & ${2:Omit<import('modern-cmdk/react').CommandRootProps, 'children'>}} props */",
      "function ${1:CommandWrapper}({ ref, ...props }) {",
      "  return (",
      "    <div ref={ref}>",
      "      <Command {...props}>",
      "        <Command.Input placeholder=\"${3:Search...}\" />",
      "        <Command.List>",
      "          $0",
      "        </Command.List>",
      "      </Command>",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "Command wrapper component with ref as prop on a wrapping div (React 19 pattern, no forwardRef)"
  },
  "Command with use() (React 19)": {
    "prefix": "cmd-use",
    "body": [
      "import { use } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "/** @param {{ itemsPromise: Promise<${2:Item}[]> }} props */",
      "function ${1:AsyncCommand}({ itemsPromise }) {",
      "  // React 19: use() unwraps promises during render",
      "  const items = use(itemsPromise);",
      "",
      "  return (",
      "    <Command label=\"${3:Command menu}\">",
      "      <Command.Input placeholder=\"${4:Search...}\" />",
      "      <Command.List>",
      "        <Command.Empty>No results found.</Command.Empty>",
      "        {items.map((item) => (",
      "          <Command.Item key={item.${5:id}} value={item.${6:value}} onSelect={item.${7:onSelect}}>",
      "            {item.${8:label}}",
      "          </Command.Item>",
      "        ))}",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette using React 19 use() to read promises"
  },
  "Command with useOptimistic (React 19)": {
    "prefix": "cmd-optimistic",
    "body": [
      "import { startTransition, useOptimistic } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "/** @param {{ items: (${2:Item} & { pending?: boolean })[] }} props */",
      "function ${1:OptimisticCommand}({ items }) {",
      "  // The reducer marks the selected item pending until the transition ends.",
      "  const [optimisticItems, markPending] = useOptimistic(",
      "    items,",
      "    /** @param {string} id */",
      "    (state, id) => state.map((item) => (item.${5:id} === id ? { ...item, pending: true } : item)),",
      "  );",
      "",
      "  return (",
      "    <Command label=\"${3:Command menu}\">",
      "      <Command.Input placeholder=\"${4:Search...}\" />",
      "      <Command.List>",
      "        {optimisticItems.map((item) => (",
      "          <Command.Item",
      "            key={item.${5:id}}",
      "            value={item.${6:value}}",
      "            onSelect={() =>",
      "              startTransition(async () => {",
      "                markPending(item.${5:id});",
      "                await ${7:persist}(item);",
      "              })",
      "            }",
      "          >",
      "            {item.${8:label}}{item.pending ? ' (saving...)' : ''}",
      "          </Command.Item>",
      "        ))}",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette with React 19 useOptimistic: the selected item shows as pending while it is saved"
  },
  "Command with useActionState (React 19)": {
    "prefix": "cmd-action",
    "body": [
      "import { startTransition, useActionState } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:ActionCommand}() {",
      "  const [items, dispatch, isPending] = useActionState(",
      "    /**",
      "     * @param {readonly ${2:Item}[]} _prev",
      "     * @param {string} query",
      "     */",
      "    async (_prev, query) => await ${3:searchItems}(query),",
      "    ${4:[]},",
      "  );",
      "",
      "  return (",
      "    <Command label=\"${5:Command menu}\">",
      "      <Command.Input",
      "        placeholder=\"${6:Search...}\"",
      "        onValueChange={(query) => startTransition(() => dispatch(query))}",
      "      />",
      "      <Command.List>",
      "        <Command.Loading loading={isPending}>Searching...</Command.Loading>",
      "        {items.map((item) => (",
      "          <Command.Item key={item.${7:id}} value={item.${8:value}}>",
      "            {item.${9:label}}",
      "          </Command.Item>",
      "        ))}",
      "        $0",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette with React 19 useActionState"
  }
}
