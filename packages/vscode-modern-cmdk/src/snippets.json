{
  "Command Palette (Basic)": {
    "prefix": "cmd-basic",
    "body": [
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:CommandPalette}() {",
      "  return (",
      "    <Command label=\"${2:Command menu}\">",
      "      <Command.Input placeholder=\"${3:Search...}\" />",
      "      <Command.List>",
      "        <Command.Empty>No results found.</Command.Empty>",
      "        <Command.Item value=\"${4:action}\" onSelect={() => ${5:console.log('selected')}}>",
      "          ${6:Action}",
      "        </Command.Item>",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Basic inline command palette"
  },
  "Command Dialog": {
    "prefix": "cmd-dialog",
    "body": [
      "import { useEffect, useState } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:CommandDialog}() {",
      "  const [open, setOpen] = useState(false);",
      "",
      "  useEffect(() => {",
      "    const controller = new AbortController();",
      "    document.addEventListener(",
      "      'keydown',",
      "      (event) => {",
      "        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {",
      "          event.preventDefault();",
      "          setOpen((current) => !current);",
      "        }",
      "      },",
      "      { signal: controller.signal },",
      "    );",
      "    return () => controller.abort();",
      "  }, []);",
      "",
      "  return (",
      "    <Command.Dialog open={open} onOpenChange={setOpen} label=\"${2:Command menu}\">",
      "      <Command.Input placeholder=\"${3:Search commands...}\" />",
      "      <Command.List>",
      "        <Command.Empty>No results found.</Command.Empty>",
      "        $0",
      "      </Command.List>",
      "    </Command.Dialog>",
      "  );",
      "}"
    ],
    "description": "Command palette in a dialog overlay, toggled with Cmd/Ctrl+K"
  },
  "Command Item": {
    "prefix": "cmd-item",
    "body": [
      "<Command.Item value=\"${1:value}\" onSelect={() => ${2:console.log('selected')}}>",
      "  ${3:Label}",
      "</Command.Item>"
    ],
    "description": "Command palette item"
  },
  "Command Group": {
    "prefix": "cmd-group",
    "body": ["<Command.Group heading=\"${1:Group}\">", "  $0", "</Command.Group>"],
    "description": "Command palette group"
  },
  "Command with Frecency": {
    "prefix": "cmd-frecency",
    "body": [
      "import { IdbFrecencyStorage, MemoryFrecencyStorage } from 'modern-cmdk';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "// IdbFrecencyStorage persists in IndexedDB; MemoryFrecencyStorage lasts until reload.",
      "const storage = ${1|new IdbFrecencyStorage(),new MemoryFrecencyStorage()|};",
      "",
      "function ${2:FrecencyPalette}() {",
      "  return (",
      "    <Command label=\"${3:Command menu}\" frecency={{ enabled: true, storage }}>",
      "      <Command.Input placeholder=\"${4:Search...}\" />",
      "      <Command.List>",
      "        $0",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette with frecency ranking"
  },
  "Command AsyncItems": {
    "prefix": "cmd-async",
    "body": [
      "<Command.AsyncItems",
      "  items={${1:itemsPromise}}",
      "  fallback={<Command.Loading loading>${2:Loading...}</Command.Loading>}",
      ">",
      "  {(items) =>",
      "    items.map((item) => (",
      "      <Command.Item key={item.id} value={item.value} onSelect={() => item.onSelect?.()}>",
      "        {item.value}",
      "      </Command.Item>",
      "    ))",
      "  }",
      "</Command.AsyncItems>"
    ],
    "description": "Async items resolved from a promise, with a loading fallback"
  },
  "useCommand Hook": {
    "prefix": "cmd-hook",
    "body": [
      "import { createCommandMachine, itemId } from 'modern-cmdk';",
      "import { useCommand } from 'modern-cmdk/react';",
      "import { useState } from 'react';",
      "",
      "function ${1:Palette}() {",
      "  const [machine] = useState(() =>",
      "    createCommandMachine({",
      "      items: [{ id: itemId('${2:action}'), value: '${3:Action}' }],",
      "    }),",
      "  );",
      "  const { state, updateSearch } = useCommand(machine);",
      "",
      "  return (",
      "    <div>",
      "      <input onChange={(event) => updateSearch(event.target.value)} />",
      "      <p>{state.filteredCount} results</p>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "useCommand hook for headless usage"
  },
  "Command Shortcut": {
    "prefix": "cmd-shortcut",
    "body": [
      "<Command.Item",
      "  value=\"${1:action}\"",
      "  shortcut=\"${2:Mod+Shift+P}\"",
      "  onSelect={() => ${3:console.log('selected')}}",
      ">",
      "  ${4:Action}",
      "  <Command.Shortcut shortcut=\"${2:Mod+Shift+P}\" />",
      "</Command.Item>"
    ],
    "description": "Command item that binds a shortcut and shows it per platform"
  },
  "Command Page": {
    "prefix": "cmd-page",
    "body": [
      "<Command.Page id=\"${1:page-id}\">",
      "  <Command.Item value=\"${2:back}\" onSelect={() => ${3:goBack()}}>",
      "    Back",
      "  </Command.Item>",
      "  $0",
      "</Command.Page>"
    ],
    "description": "Command palette page (nested navigation)"
  }
}
