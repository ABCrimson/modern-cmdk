{
  "name": "modern-cmdk-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.4.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:docs": "playwright test -c playwright.docs.config.ts",
    "bench": "vitest bench",
    "bench:compare": "node benchmarks/standalone/compare-baseline.ts",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "pnpm --filter modern-cmdk --filter modern-cmdk-codemod --filter create-modern-cmdk exec tsc --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p tests/docs/tsconfig.json --noEmit && pnpm --filter docs exec vue-tsc --noEmit",
    "size": "pnpm build && size-limit",
    "check:package": "node scripts/check-package.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:doc-samples": "node scripts/check-doc-samples.ts",
    "check:snippets": "node scripts/check-snippets.ts",
    "check:repo-links": "node scripts/check-repo-links.ts",
    "check:notices": "node scripts/third-party-notices.ts --check",
    "test:consumers": "node scripts/consumer-smoke.ts",
    "test:templates": "node scripts/template-smoke.ts",
    "test:codemod-tarball": "node scripts/codemod-tarball-smoke.ts",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.1-b609be2.0.sha-b609be2",
    "@biomejs/biome": "2.6.6",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@js-temporal/polyfill": "0.5.1",
    "@playwright/test": "1.66.0-alpha-2026-11-08",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jscodeshift": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "cmdk": "1.1.1",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "idb-keyval": "6.3.0",
    "jscodeshift": "catalog:",
    "lefthook": "2.2.2",
    "next": "16.5.0-canary.44",
    "publint": "0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "14.3.0",
    "tinybench": "6.2.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "web-features": "3.45.0-dev-20261103105955-64427e2"
  },
  "size-limit": [
    {
      "name": "modern-cmdk (core)",
      "path": "packages/modern-cmdk/dist/core/index.mjs",
      "limit": "7.4 kB",
      "gzip": true
    },
    {
      "name": "modern-cmdk/react (adapter only)",
      "path": "packages/modern-cmdk/dist/react/index.mjs",
      "limit": "5.7 kB",
      "gzip": true,
      "ignore": [
        "modern-cmdk",
        "react",
        "react-dom",
        "react-dom/client",
        "react/jsx-runtime",
        "radix-ui"
      ]
    },
    {
      "name": "modern-cmdk/react/dialog (adapter only)",
      "path": "packages/modern-cmdk/dist/react/dialog.mjs",
      "limit": "1.5 kB",
      "gzip": true,
      "ignore": [
        "modern-cmdk",
        "react",
        "react-dom",
        "react-dom/client",
        "react/jsx-runtime",
        "radix-ui"
      ]
    },
    {
      "name": "modern-cmdk/react: CommandSeparator only",
      "path": "packages/modern-cmdk/dist/react/index.mjs",
      "import": "{ CommandSeparator }",
      "limit": "5 kB",
      "gzip": true,
      "ignore": [
        "modern-cmdk",
        "react",
        "react-dom",
        "react-dom/client",
        "react/jsx-runtime",
        "radix-ui"
      ]
    },
    {
      "name": "modern-cmdk + modern-cmdk/react",
      "path": "packages/modern-cmdk/dist/react/index.mjs",
      "limit": "10.85 kB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "react-dom/client",
        "react/jsx-runtime",
        "radix-ui"
      ]
    },
    {
      "name": "modern-cmdk/styles.css",
      "path": "packages/modern-cmdk/dist/react/styles.css",
      "limit": "4 kB",
      "gzip": true,
      "rolldown": false
    },
    {
      "name": "modern-cmdk codemod bin (installed size)",
      "path": [
        "packages/modern-cmdk/dist/codemod/*.mjs",
        "packages/modern-cmdk/dist/codemod/transforms/*.mjs"
      ],
      "limit": "3.4 MB",
      "gzip": false,
      "brotli": false,
      "rolldown": false
    },
    {
      "name": "modern-cmdk codemod shim (bin.mjs)",
      "path": "packages/modern-cmdk/dist/codemod/bin.mjs",
      "limit": "1 kB",
      "gzip": false,
      "brotli": false,
      "rolldown": false
    },
    {
      "name": "modern-cmdk-codemod (own files, dependencies excluded)",
      "path": [
        "packages/modern-cmdk-codemod/dist/*.mjs",
        "packages/modern-cmdk-codemod/dist/transforms/*.mjs"
      ],
      "limit": "102 kB",
      "gzip": false,
      "brotli": false,
      "rolldown": false
    }
  ]
}
