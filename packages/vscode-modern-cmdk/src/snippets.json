{
  "Command Palette (Basic)": {
    "prefix": "cmd-basic",
    "body": [
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:CommandPalette}() {",
      "  return (",
      "    <Command label=\"${2:Command menu}\">",
      "      <Command.Input placeholder=\"${3:Search...}\" />",
      "      <Command.List>",
      "        <Command.Empty>No results found.</Command.Empty>",
      "        <Command.Item value=\"${4:action}\" onSelect={() => ${5:console.log('selected')}}>",
      "          ${6:Action}",
      "        </Command.Item>",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Basic inline command palette"
  },
  "Command Dialog": {
    "prefix": "cmd-dialog",
    "body": [
      "import { useEffect, useState } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:CommandDialog}() {",
      "  const [open, setOpen] = useState(false);",
      "",
      "  useEffect(() => {",
      "    const controller = new AbortController();",
      "    document.addEventListener(",
      "      'keydown',",
      "      (event) => {",
      "        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {",
      "          event.preventDefault();",
      "          setOpen((current) => !current);",
      "        }",
      "      },",
      "      { signal: controller.signal },",
      "    );",
      "    return () => controller.abort();",
      "  }, []);",
      "",
      "  return (",
      "    <Command.Dialog open={open} onOpenChange={setOpen} label=\"${2:Command menu}\">",
      "      <Command.Input placeholder=\"${3:Search commands...}\" />",
      "      <Command.List>",
      "        <Command.Empty>No results found.</Command.Empty>",
      "        $0",
      "      </Command.List>",
      "    </Command.Dialog>",
      "  );",
      "}"
    ],
    "description": "Command palette in a dialog overlay, toggled with Cmd/Ctrl+K"
  },
  "Command Item": {
    "prefix": "cmd-item",
    "body": [
      "<Command.Item value=\"${1:value}\" onSelect={() => ${2:console.log('selected')}}>",
      "  ${3:Label}",
      "</Command.Item>"
    ],
    "description": "Command palette item"
  },
  "Command Group": {
    "prefix": "cmd-group",
    "body": ["<Command.Group heading=\"${1:Group}\">", "  $0", "</Command.Group>"],
    "description": "Command palette group"
  },
  "Command with Frecency": {
    "prefix": "cmd-frecency",
    "body": [
      "import { IdbFrecencyStorage, MemoryFrecencyStorage } from 'modern-cmdk';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "// IdbFrecencyStorage persists in IndexedDB; MemoryFrecencyStorage lasts until reload.",
      "const storage = ${1|new IdbFrecencyStorage(),new MemoryFrecencyStorage()|};",
      "",
      "function ${2:FrecencyPalette}() {",
      "  return (",
      "    <Command label=\"${3:Command menu}\" frecency={{ enabled: true, storage }}>",
      "      <Command.Input placeholder=\"${4:Search...}\" />",
      "      <Command.List>",
      "        $0",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette with frecency ranking"
  },
  "Command AsyncItems": {
    "prefix": "cmd-async",
    "body": [
      "<Command.AsyncItems",
      "  items={${1:itemsPromise}}",
      "  fallback={<Command.Loading loading>${2:Loading...}</Command.Loading>}",
      ">",
      "  {(items) =>",
      "    items.map((item) => (",
      "      <Command.Item key={item.id} value={item.value} onSelect={() => item.onSelect?.()}>",
      "        {item.value}",
      "      </Command.Item>",
      "    ))",
      "  }",
      "</Command.AsyncItems>"
    ],
    "description": "Async items resolved from a promise, with a loading fallback"
  },
  "useCommand Hook": {
    "prefix": "cmd-hook",
    "body": [
      "import { createCommandMachine, itemId } from 'modern-cmdk';",
      "import { useCommand } from 'modern-cmdk/react';",
      "import { useState } from 'react';",
      "",
      "function ${1:Palette}() {",
      "  const [machine] = useState(() =>",
      "    createCommandMachine({",
      "      items: [{ id: itemId('${2:action}'), value: '${3:Action}' }],",
      "    }),",
      "  );",
      "  const { state, updateSearch } = useCommand(machine);",
      "",
      "  return (",
      "    <div>",
      "      <input onChange={(event) => updateSearch(event.target.value)} />",
      "      <p>{state.filteredCount} results</p>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "useCommand hook for headless usage"
  },
  "Command Shortcut": {
    "prefix": "cmd-shortcut",
    "body": [
      "<Command.Item",
      "  value=\"${1:action}\"",
      "  shortcut=\"${2:Ctrl+Shift+P}\"",
      "  onSelect={() => ${3:console.log('selected')}}",
      ">",
      "  ${4:Action}",
      "  <Command.Shortcut>${2:Ctrl+Shift+P}</Command.Shortcut>",
      "</Command.Item>"
    ],
    "description": "Command item with keyboard shortcut"
  },
  "Command Page": {
    "prefix": "cmd-page",
    "body": [
      "<Command.Page id=\"${1:page-id}\">",
      "  <Command.Item value=\"${2:back}\" onSelect={() => ${3:goBack()}}>",
      "    Back",
      "  </Command.Item>",
      "  $0",
      "</Command.Page>"
    ],
    "description": "Command palette page (nested navigation)"
  },
  "Command Component with ref (React 19)": {
    "prefix": "cmd-component-ref",
    "body": [
      "import { Command, type CommandRootProps } from 'modern-cmdk/react';",
      "import type { Ref } from 'react';",
      "",
      "// React 19: ref is a regular prop, no forwardRef needed.",
      "// Command renders no ref target of its own, so the ref goes on a wrapping div.",
      "function ${1:CommandWrapper}({ ref, ...props }: { ref?: Ref<HTMLDivElement> } & ${2:Omit<CommandRootProps, 'children'>}) {",
      "  return (",
      "    <div ref={ref}>",
      "      <Command {...props}>",
      "        <Command.Input placeholder=\"${3:Search...}\" />",
      "        <Command.List>",
      "          $0",
      "        </Command.List>",
      "      </Command>",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "Command wrapper component with ref as prop on a wrapping div (React 19 pattern, no forwardRef)"
  },
  "Command with use() (React 19)": {
    "prefix": "cmd-use",
    "body": [
      "import { use } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:AsyncCommand}({ itemsPromise }: { itemsPromise: Promise<${2:Item}[]> }) {",
      "  // React 19: use() unwraps promises during render",
      "  const items = use(itemsPromise);",
      "",
      "  return (",
      "    <Command label=\"${3:Command menu}\">",
      "      <Command.Input placeholder=\"${4:Search...}\" />",
      "      <Command.List>",
      "        <Command.Empty>No results found.</Command.Empty>",
      "        {items.map((item) => (",
      "          <Command.Item key={item.${5:id}} value={item.${6:value}} onSelect={item.${7:onSelect}}>",
      "            {item.${8:label}}",
      "          </Command.Item>",
      "        ))}",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette using React 19 use() to read promises"
  },
  "Command with useOptimistic (React 19)": {
    "prefix": "cmd-optimistic",
    "body": [
      "import { startTransition, useOptimistic } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:OptimisticCommand}({ items }: { items: ${2:Item}[] }) {",
      "  const [optimisticItems, addOptimistic] = useOptimistic(",
      "    items,",
      "    (state, newItem: ${2:Item}) => [...state, newItem],",
      "  );",
      "",
      "  return (",
      "    <Command label=\"${3:Command menu}\">",
      "      <Command.Input placeholder=\"${4:Search...}\" />",
      "      <Command.List>",
      "        {optimisticItems.map((item) => (",
      "          <Command.Item",
      "            key={item.${5:id}}",
      "            value={item.${6:value}}",
      "            onSelect={() =>",
      "              startTransition(async () => {",
      "                addOptimistic(item);",
      "                await ${7:persist}(item);",
      "              })",
      "            }",
      "          >",
      "            {item.${8:label}}",
      "          </Command.Item>",
      "        ))}",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette with React 19 useOptimistic for instant UI updates"
  },
  "Command with useActionState (React 19)": {
    "prefix": "cmd-action",
    "body": [
      "import { startTransition, useActionState } from 'react';",
      "import { Command } from 'modern-cmdk/react';",
      "",
      "function ${1:ActionCommand}() {",
      "  const [items, dispatch, isPending] = useActionState(",
      "    async (_prev: readonly ${2:Item}[], query: string) => await ${3:searchItems}(query),",
      "    ${4:[]},",
      "  );",
      "",
      "  return (",
      "    <Command label=\"${5:Command menu}\">",
      "      <Command.Input",
      "        placeholder=\"${6:Search...}\"",
      "        onValueChange={(query) => startTransition(() => dispatch(query))}",
      "      />",
      "      <Command.List>",
      "        <Command.Loading loading={isPending}>Searching...</Command.Loading>",
      "        {items.map((item) => (",
      "          <Command.Item key={item.${7:id}} value={item.${8:value}}>",
      "            {item.${9:label}}",
      "          </Command.Item>",
      "        ))}",
      "        $0",
      "      </Command.List>",
      "    </Command>",
      "  );",
      "}"
    ],
    "description": "Command palette with React 19 useActionState"
  }
}
