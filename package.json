{
  "name": "modern-cmdk-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26.4.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest bench",
    "bench:ci": "node --import tsx benchmarks/standalone/ci-bench.ts",
    "bench:compare": "node --import tsx benchmarks/standalone/compare-baseline.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "pnpm --filter modern-cmdk --filter playground --filter modern-cmdk-search-wasm --filter create-modern-cmdk exec tsc --noEmit",
    "size": "pnpm build && size-limit",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "changeset": "changeset",
    "version": "changeset version",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1-e9cf392.0.sha-e9cf392",
    "@biomejs/biome": "2.6.4",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@js-temporal/polyfill": "0.5.1",
    "@playwright/test": "1.65.0-alpha-2026-10-31",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jscodeshift": "17.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0-beta.1",
    "cmdk": "1.1.1",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "idb-keyval": "6.3.0",
    "jscodeshift": "17.4.0",
    "lefthook": "2.2.2",
    "react": "0.0.0-experimental-a703ca64-20261030",
    "react-dom": "0.0.0-experimental-a703ca64-20261030",
    "size-limit": "14.3.0",
    "tinybench": "6.2.2",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "typescript": "7.1.0-dev.20261031.1",
    "vitest": "5.1.0-beta.1"
  },
  "size-limit": [
    {
      "name": "modern-cmdk (core)",
      "path": "packages/modern-cmdk/dist/core/index.mjs",
      "limit": "6.5 kB",
      "gzip": true
    },
    {
      "name": "modern-cmdk/react",
      "path": "packages/modern-cmdk/dist/react/index.mjs",
      "limit": "12 kB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "react-dom/client",
        "react/jsx-runtime",
        "radix-ui"
      ]
    }
  ]
}
