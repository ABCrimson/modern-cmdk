{
  "name": "modern-cmdk",
  "version": "1.7.2",
  "type": "module",
  "description": "Headless command palette engine: a framework-agnostic TypeScript core with fuzzy search, frecency ranking and keyboard shortcuts, plus a React 19 adapter.",
  "license": "MIT",
  "homepage": "https://abcrimson.github.io/modern-cmdk/",
  "bugs": {
    "url": "https://github.com/ABCrimson/modern-cmdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "default": "./dist/core/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "default": "./dist/react/index.mjs"
    },
    "./react/dialog": {
      "types": "./dist/react/dialog.d.mts",
      "default": "./dist/react/dialog.mjs"
    },
    "./styles.css": "./dist/react/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.mjs",
  "types": "./dist/core/index.d.mts",
  "bin": {
    "modern-cmdk": "./dist/codemod/bin.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0 <21.0.0",
    "react-dom": ">=19.0.0 <21.0.0",
    "radix-ui": ">=1.4.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "radix-ui": "catalog:"
  },
  "keywords": [
    "command-palette",
    "command-menu",
    "cmdk",
    "cmd-k",
    "headless",
    "state-machine",
    "combobox",
    "wai-aria",
    "accessibility",
    "fuzzy-search",
    "frecency",
    "keyboard-shortcuts",
    "virtualization",
    "typescript",
    "esm",
    "react",
    "react-19",
    "radix-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/modern-cmdk.git",
    "directory": "packages/modern-cmdk"
  }
}
